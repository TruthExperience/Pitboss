{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "PitBoss Portal (Vite PWA)",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@/*": ["./src/*"],
      "@pitboss/core-domain": ["../../packages/core-domain/src/index.ts"],
      "@pitboss/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
