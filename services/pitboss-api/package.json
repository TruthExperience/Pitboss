{
  "name": "@pitboss/pitboss-api",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@pitboss/core-domain": "workspace:*",
    "@pitboss/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
